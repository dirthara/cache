{
    "name": "dirthara/cache-psr-tests",
    "description": "Isolated PSR compliance tests for Dirthara Cache",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "cache/integration-tests": "^1.0.5",
        "phpunit/phpunit": "^13.3",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Dirthara\\Cache\\": "../../src/",
            "Dirthara\\Cache\\Tests\\Fixtures\\Integration\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
